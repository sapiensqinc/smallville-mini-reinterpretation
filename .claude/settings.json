{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "sapiensq": {
      "source": {
        "source": "github",
        "repo": "sapiensqinc/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "sq-craft@sapiensq": true,
    "sq-sec@sapiensq": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote -v:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(du -sh:*)",
      "Bash(file:*)",
      "Bash(gh repo view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh auth status)",
      "Bash(gh api orgs/sapiensqinc*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",
      "Bash(npm ls:*)",
      "Bash(npm view:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh release create:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down)",
      "Bash(docker exec:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/*secrets*)",
      "Read(**/id_rsa*)",
      "Read(**/*.pem)",
      "Bash(cat *.env)",
      "Bash(echo * > *.env)"
    ]
  }
}
